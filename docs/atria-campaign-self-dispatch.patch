+
+      # Primary continuation path. The campaign exits 8 when it pauses
+      # resumably, and historically waited for a cron tick that GitHub
+      # frequently never delivered. Dispatching the next leg here makes the
+      # chain deterministic: the concurrency group queues it behind this very
+      # job, so it starts as soon as this one releases the slot.
+      #
+      # This step grants no new authority. The continuation re-enters the
+      # same supervisor decision as a cron tick, against the state artifact
+      # this job just uploaded, so a terminal marker, an operator pause, an
+      # exhausted retry ledger, or a completed campaign all still stop the
+      # chain there. That is also what terminates the loop: a continuation
+      # whose decision is "none" skips this step and dispatches nothing.
+      - name: Chain the next dispatch
+        # Only after the campaign actually ran: a setup/checkout failure must
+        # not spin a dispatch loop, and cron still covers that case.
+        if: always() && steps.campaign.conclusion != 'skipped' && steps.mode.outputs.mode != 'none'
+        env:
+          GH_TOKEN: ${{ github.token }}
+          CHAIN_DEPTH: ${{ github.event_name == 'workflow_dispatch' && inputs.chain_depth || '0' }}
+          CHAIN_REF: ${{ steps.mode.outputs.ref }}
+        run: |
+          set -uo pipefail
+          # Backstop against a pathological loop the supervisor fails to stop.
+          # A full campaign is a few dozen legs; 500 is far above that and far
+          # below anything expensive, and cron still continues past it.
+          CHAIN_MAX=500
+          DEPTH=$(printf '%s' "${CHAIN_DEPTH:-0}" | tr -cd '0-9')
+          DEPTH=${DEPTH:-0}
+          if [ "$DEPTH" -ge "$CHAIN_MAX" ]; then
+            echo "chain depth $DEPTH reached the $CHAIN_MAX backstop; leaving continuation to cron"
+            exit 0
+          fi
+          # A terminal marker is the wrapper's explicit "do not retry".
+          if [ -f runs/atria_campaign/wrapper_failed.json ]; then
+            echo "wrapper recorded a terminal failure; not chaining"
+            cat runs/atria_campaign/wrapper_failed.json || true
+            exit 0
+          fi
+          STATUS=$(jq -r '.status // ""' runs/atria_campaign/campaign_report.json 2>/dev/null || true)
+          case "$STATUS" in
+            completed|gate_passed)
+              echo "campaign $STATUS; nothing to continue"
+              exit 0
+              ;;
+          esac
+          NEXT=$((DEPTH + 1))
+          echo "chaining continuation $NEXT (status='${STATUS:-unknown}', ref=$CHAIN_REF)"
+          # Best-effort: a failed dispatch must not fail the job, because cron
+          # remains the fallback continuation path.
+          gh workflow run atria-campaign.yml \
+            --ref "${{ github.ref_name }}" \
+            -f ref="$CHAIN_REF" \
+            -f continuation=true \
+            -f chain_depth="$NEXT" \
+            || echo "continuation dispatch failed; cron will pick the state up instead"
