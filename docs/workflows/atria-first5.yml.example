name: Atria Dawn Preview first-five pilot

on:
  workflow_dispatch:
    inputs:
      ref:
        description: "Branch or full commit SHA containing the pinned Atria pilot code"
        required: true
        default: "arena/01a0dc92-rl-eval-generator"

permissions:
  contents: read

# Prevent two account-wide 60 RPM pilot budgets from running concurrently.
concurrency:
  group: atria-first5
  cancel-in-progress: false

jobs:
  pilot:
    runs-on: ubuntu-latest
    # The controller enforces the two-hour pilot wall limit. This larger job
    # limit leaves room for checkout, dependencies, the exact-instance gate
    # (Glyph reference alone takes ~9-10 CPU-minutes), Docker, and artifacts.
    timeout-minutes: 135
    steps:
      - name: Check out pinned evaluation code
        uses: actions/checkout@v4
        with:
          ref: ${{ inputs.ref }}

      - name: Set up Python
        uses: actions/setup-python@v5
        with:
          python-version: "3.11"
          cache: pip

      - name: Install controller dependencies
        run: python -m pip install -r requirements.txt

      # The exact-instance oracle gate judges the selected (environment,
      # difficulty, seed) triples on the HOST, through the real patch
      # validator and judge code, before any provider call. The generated
      # judges import torch, and the Glyph reference trains on the host, so
      # the gate blocks (exit 2) without a PyTorch runtime. The versions are
      # pinned to the documented offline validation baseline and to the
      # judge Docker image pin, so the host gate and the container judges
      # run the same torch.
      - name: Install pinned CPU PyTorch stack for the exact-instance gate
        run: |
          python -m pip install --index-url https://download.pytorch.org/whl/cpu torch==2.5.1 torchvision==0.20.1
          python -m pip install jinja2

      - name: Run only the bounded Atria first-five profile
        env:
          # The host controller reads this value. It is never placed in a
          # Docker agent/judge environment, command argument, or artifact.
          ATRIA_API_KEY: ${{ secrets.ATRIA_API_KEY }}
        run: |
          set -euo pipefail
          python tools/atria_first_experiment.py \
            --profile experiments/atria_first5.yaml \
            --out runs/atria_first5

      - name: Upload non-secret pilot artifacts
        if: always()
        uses: actions/upload-artifact@v4
        with:
          name: atria-first5-${{ github.run_id }}
          path: |
            runs/atria_first5/**
            !runs/atria_first5/**/secret_key.json
            !secret_key.json
          if-no-files-found: warn
          retention-days: 7
