# One manual dispatch starts a checkpointed covering experiment. Provider-free
# exact-instance gates and paid episodes may span multiple Actions jobs; every
# resumable state is uploaded and the scheduled supervisor continues the same
# pinned revision until all selected cases are recorded.
name: Atria covering campaign

on:
  workflow_dispatch:
    inputs:
      execution_mode:
        description: "paid runs the full experiment after gates; gates_only diagnoses eligibility without provider requests"
        type: choice
        required: true
        default: paid
        options:
          - paid
          - gates_only
      paid_campaign_approval:
        description: "Required for paid mode: type START_PAID_CAMPAIGN exactly"
        type: string
        required: false
        default: ""
  schedule:
    - cron: "13,43 * * * *"

permissions:
  contents: read
  actions: read

concurrency:
  group: atria-campaign
  cancel-in-progress: false

jobs:
  campaign:
    runs-on: ubuntu-latest
    # GitHub allows at most six hours. The controller leaves upload headroom
    # and checkpoints both the gate and episode phases before this deadline.
    timeout-minutes: 350
    steps:
      - name: Decide fresh dispatch or resumable continuation
        id: mode
        env:
          GH_TOKEN: ${{ github.token }}
        run: |
          set -euo pipefail
          if [ "${{ github.event_name }}" = "workflow_dispatch" ]; then
            EXECUTION_MODE="${{ inputs.execution_mode }}"
            if [ "$EXECUTION_MODE" = "paid" ] && [ "${{ inputs.paid_campaign_approval }}" != "START_PAID_CAMPAIGN" ]; then
              echo "mode=none" >> "$GITHUB_OUTPUT"
              echo "reason=paid mode requires paid_campaign_approval=START_PAID_CAMPAIGN" >> "$GITHUB_OUTPUT"
              exit 0
            fi
            # The code that defines the UI controls is the code that runs;
            # there is no second ref input that can silently select another
            # branch or an older controller.
            echo "mode=fresh" >> "$GITHUB_OUTPUT"
            echo "ref=${{ github.sha }}" >> "$GITHUB_OUTPUT"
            echo "execution_mode=$EXECUTION_MODE" >> "$GITHUB_OUTPUT"
            echo "reason=manual $EXECUTION_MODE dispatch at ${{ github.sha }}" >> "$GITHUB_OUTPUT"
            exit 0
          fi

          LATEST=$(gh api "repos/${{ github.repository }}/actions/artifacts?per_page=100" \
            --jq '[.artifacts[] | select(.name | startswith("atria-campaign-state-")) | select(.expired == false)] | sort_by(.created_at) | last')
          if [ "$LATEST" = "null" ] || [ -z "$LATEST" ]; then
            echo "mode=none" >> "$GITHUB_OUTPUT"
            echo "reason=no campaign state artifact" >> "$GITHUB_OUTPUT"
            exit 0
          fi
          ARTIFACT_ID=$(echo "$LATEST" | jq -r '.id')
          STATE_STAGE="$RUNNER_TEMP/atria_state"
          rm -rf "$STATE_STAGE"
          mkdir -p "$STATE_STAGE"
          gh api "repos/${{ github.repository }}/actions/artifacts/$ARTIFACT_ID/zip" > "$RUNNER_TEMP/state.zip"
          unzip -q "$RUNNER_TEMP/state.zip" -d "$STATE_STAGE"
          PINNED_REF=$(cat "$STATE_STAGE/campaign_ref.txt" 2>/dev/null || true)
          if [ -z "$PINNED_REF" ]; then
            echo "mode=none" >> "$GITHUB_OUTPUT"
            echo "reason=state artifact has no campaign_ref" >> "$GITHUB_OUTPUT"
            exit 0
          fi
          SUPERVISOR="$RUNNER_TEMP/campaign_supervisor.py"
          if ! gh api "repos/${{ github.repository }}/contents/tools/campaign_supervisor.py?ref=$PINNED_REF" --jq '.content' | base64 -d > "$SUPERVISOR" 2>/dev/null || [ ! -s "$SUPERVISOR" ]; then
            echo "mode=none" >> "$GITHUB_OUTPUT"
            echo "reason=cannot load the supervisor pinned by campaign state" >> "$GITHUB_OUTPUT"
            exit 0
          fi
          DECISION_JSON=$(python3 -c '
          import importlib.util, json, sys
          spec = importlib.util.spec_from_file_location("campaign_supervisor", sys.argv[1])
          module = importlib.util.module_from_spec(spec)
          spec.loader.exec_module(module)
          print(json.dumps(module.decide_tick(sys.argv[2])))
          ' "$SUPERVISOR" "$STATE_STAGE")
          MODE=$(printf '%s' "$DECISION_JSON" | jq -r '.mode')
          REASON=$(printf '%s' "$DECISION_JSON" | jq -r '.reason')
          echo "mode=$MODE" >> "$GITHUB_OUTPUT"
          echo "reason=$REASON" >> "$GITHUB_OUTPUT"
          if [ "$MODE" != "none" ]; then
            REF=$(printf '%s' "$DECISION_JSON" | jq -r '.ref')
            EXECUTION_MODE=$(printf '%s' "$DECISION_JSON" | jq -r '.execution_mode')
            echo "ref=$REF" >> "$GITHUB_OUTPUT"
            echo "execution_mode=$EXECUTION_MODE" >> "$GITHUB_OUTPUT"
            echo "state_staged=true" >> "$GITHUB_OUTPUT"
          fi

      - name: Check out pinned campaign code
        if: steps.mode.outputs.mode != 'none'
        uses: actions/checkout@v4
        with:
          ref: ${{ steps.mode.outputs.ref }}
          fetch-depth: 0

      - name: Refuse incomplete controller revisions
        if: steps.mode.outputs.mode != 'none'
        run: |
          test -f tools/instance_oracle_gate.py
          test -f tools/campaign_supervisor.py
          test -f tools/atria_campaign.py

      - name: Set up Python
        if: steps.mode.outputs.mode != 'none'
        uses: actions/setup-python@v5
        with:
          python-version: "3.11"
          cache: pip

      - name: Install controller dependencies
        if: steps.mode.outputs.mode != 'none'
        run: python -m pip install -r requirements.txt

      - name: Install pinned CPU PyTorch for exact-instance gates
        if: steps.mode.outputs.mode != 'none'
        run: |
          python -m pip install --index-url https://download.pytorch.org/whl/cpu torch==2.5.1 torchvision==0.20.1
          python -m pip install jinja2

      - name: Restore continuation state
        if: steps.mode.outputs.mode != 'none' && steps.mode.outputs.state_staged == 'true'
        run: |
          set -euo pipefail
          mkdir -p runs/atria_campaign
          cp -a "$RUNNER_TEMP/atria_state/." runs/atria_campaign/

      - name: Record the exact code ref
        if: steps.mode.outputs.mode != 'none'
        run: |
          mkdir -p runs/atria_campaign
          echo "${{ steps.mode.outputs.ref }}" > runs/atria_campaign/campaign_ref.txt

      - name: Run provider-free gate continuation
        if: steps.mode.outputs.mode != 'none' && steps.mode.outputs.execution_mode == 'gates_only'
        timeout-minutes: 340
        run: |
          set +e
          python tools/atria_campaign.py \
            --profile experiments/atria_campaign.yaml \
            --out runs/atria_campaign \
            --gates-only
          rc=$?
          set -e
          python - "$rc" <<'PY'
          import json, pathlib, sys
          rc = int(sys.argv[1])
          report_path = pathlib.Path("runs/atria_campaign/campaign_report.json")
          report = json.loads(report_path.read_text()) if report_path.exists() else {}
          if rc == 0 or (report.get("status") == "paused" and report.get("resumable") is True):
              raise SystemExit(0)
          raise SystemExit(rc)
          PY

      - name: Run paid campaign continuation
        if: steps.mode.outputs.mode != 'none' && steps.mode.outputs.execution_mode == 'paid'
        timeout-minutes: 340
        env:
          # The controller alone reads this value. It is never supplied to an
          # agent/judge container or written to an artifact.
          ATRIA_API_KEY: ${{ secrets.ATRIA_API_KEY }}
        run: |
          set +e
          python tools/atria_campaign.py \
            --profile experiments/atria_campaign.yaml \
            --out runs/atria_campaign \
            --allow-provider
          rc=$?
          set -e
          python - "$rc" <<'PY'
          import json, pathlib, sys
          rc = int(sys.argv[1])
          report_path = pathlib.Path("runs/atria_campaign/campaign_report.json")
          report = json.loads(report_path.read_text()) if report_path.exists() else {}
          if rc == 0 or (report.get("status") == "paused" and report.get("resumable") is True):
              raise SystemExit(0)
          raise SystemExit(rc)
          PY

      - name: Upload campaign state
        if: always() && steps.mode.outputs.mode != 'none'
        uses: actions/upload-artifact@v4
        with:
          name: atria-campaign-state-${{ github.run_number }}
          path: |
            runs/atria_campaign/**
            !runs/atria_campaign/**/secret_key.json
            !secret_key.json
          if-no-files-found: warn
          retention-days: 90
