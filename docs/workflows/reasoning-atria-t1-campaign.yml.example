# DEPLOYABLE SOURCE for .github/workflows/reasoning-atria-t1-campaign.yml.
#
# Copy this file to .github/workflows/reasoning-atria-t1-campaign.yml BY HAND.
# The branch that carries it cannot push to that path: the GitHub App token used
# for automation has no `workflows` permission, so any change under
# .github/workflows/ is rejected outright (the same reason atria-campaign.yml and
# mercury-t1-campaign.yml are hand-copied from docs/workflows/*.yml.example).
# Once copied to the default branch it is dispatchable from the Actions tab
# (workflow_dispatch), or via the API against a branch that contains it.
#
# Nothing else about this file is hand-editable-only: it is the exact workflow the
# probe + profile in this repo drive. Keep it in sync with
# experiments/t1_reasoning_atria.yaml and tools/matched_fact_probe.py.

name: Reasoning Atria T1 matched-fact presentation campaign

# Lean direct-answer campaign for the T1 same_fact_presentation operator against
# Atria-Dawn-Preview with CONTROLLED reasoning. This is the Atria arm of the
# paired Atria-vs-Mercury comparison: it runs the SAME covering matrix as
# mercury-t1-campaign.yml, so a case identified by (seed, n_facts, prior) has the
# same id in both runs and the paired report joins them on their shared cases.
#
# Atria exposes controlled reasoning ONLY on the OpenAI-Responses surface
# (/v1/responses) as a nested `reasoning: {effort}` field, so this campaign sets
# target.wire_api: responses. Its Chat Completions endpoint has no reasoning
# control (hence the Chat-Completions Atria pilot is `provider_default_uncontrolled`).
# Mercury's reasoning knob is the FLAT Chat-Completions `reasoning_effort`; the
# two are different mechanisms and the report records wire_api + reasoning_mode
# separately so they are never silently pooled. See arena/providers.py
# (complete_responses) and arena/matched_facts.py (reporting boundary).
#
# Safety shape:
#   * An offline --plan preflight runs BEFORE any provider access and fails
#     closed if the matrix exceeds the call budget.
#   * ATRIA_API_KEY is read by the host controller only; there is no container to
#     leak it into, and it is never written to an artifact or command argument.
#   * A concurrency group prevents two campaigns contending for the shared
#     account-wide 60 requests/minute Atria limit at once.

on:
  workflow_dispatch:
    inputs:
      ref:
        description: "Branch or full commit SHA containing the pinned T1 probe code"
        required: true
        default: "arena/3fd95b93-rl-eval-generator"
      profile:
        description: "T1 campaign profile (target + covering matrix)"
        required: false
        default: "experiments/t1_reasoning_atria.yaml"

permissions:
  contents: read

concurrency:
  group: reasoning-atria-t1-campaign
  cancel-in-progress: false

jobs:
  campaign:
    runs-on: ubuntu-latest
    # 72 single-turn reasoning-high calls at >=1.1s spacing (60 RPM account cap)
    # plus per-call reasoning latency fit the two-hour job budget with margin.
    # If measured latency still threatens this budget, reduce `seeds`
    # SYMMETRICALLY in BOTH t1 profiles.
    timeout-minutes: 120
    steps:
      - name: Check out pinned probe code
        uses: actions/checkout@v4
        with:
          ref: ${{ inputs.ref }}

      # Fail closed on any ref that predates the T1 probe or the Responses path.
      - name: Refuse ungated code
        run: |
          test -f tools/matched_fact_probe.py || { echo "ref lacks the T1 probe tool"; exit 1; }
          test -f arena/matched_facts.py || { echo "ref lacks the T1 contract"; exit 1; }
          test -f arena/providers.py || { echo "ref lacks the provider client"; exit 1; }
          grep -q "def complete_responses" arena/providers.py || { echo "ref lacks the Responses-API client path"; exit 1; }
          test -f "${{ inputs.profile }}" || { echo "ref lacks the campaign profile"; exit 1; }

      - name: Set up Python
        uses: actions/setup-python@v5
        with:
          python-version: "3.11"
          cache: pip

      - name: Install controller dependencies
        run: python -m pip install -r requirements.txt

      # Offline preflight: prove the profile is well-formed and within the call
      # budget BEFORE any provider access. --plan exits nonzero if out of budget.
      - name: Offline plan preflight (no provider access)
        run: |
          set -euo pipefail
          mkdir -p runs/t1_reasoning_atria
          python tools/matched_fact_probe.py --profile "${{ inputs.profile }}" --plan \
            | tee runs/t1_reasoning_atria/plan.json
          # `tee` masks the probe exit code behind the pipe; re-assert it.
          python tools/matched_fact_probe.py --profile "${{ inputs.profile }}" --plan >/dev/null

      - name: Run the T1 matched-fact campaign (live)
        env:
          # The host controller reads this value. There is no Docker agent or
          # judge in this lean probe, so it never reaches a container, a command
          # argument, or an artifact.
          ATRIA_API_KEY: ${{ secrets.ATRIA_API_KEY }}
        run: |
          set -euo pipefail
          python tools/matched_fact_probe.py \
            --profile "${{ inputs.profile }}" \
            --out runs/t1_reasoning_atria/report.json

      - name: Upload non-secret campaign artifacts
        if: always()
        uses: actions/upload-artifact@v4
        with:
          name: reasoning-atria-t1-${{ github.run_id }}
          path: |
            runs/t1_reasoning_atria/**
          if-no-files-found: warn
          retention-days: 30
