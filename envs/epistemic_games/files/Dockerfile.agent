FROM python:3.11-slim

# The epistemic_games family is pure reasoning: no ML stack is needed in the
# agent container. Keep the image small and dependency-free.
RUN pip install --no-cache-dir pytest \
    && useradd -m -u 10001 agent

COPY workspace/ /originals/
COPY tools/ /tools/
COPY agent_entrypoint.sh /agent_entrypoint.sh

RUN chmod -R a+rX /originals /tools /agent_entrypoint.sh \
    && chmod +x /tools/submit.py /agent_entrypoint.sh

WORKDIR /workspace
CMD ["/agent_entrypoint.sh"]
